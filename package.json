{
  "name": "@stll/folio-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "folio monorepo: framework-neutral DOCX engine, React/Vue editors, Nuxt module, and agent tooling.",
  "homepage": "https://github.com/stella/folio",
  "bugs": {
    "url": "https://github.com/stella/folio/issues"
  },
  "license": "Apache-2.0",
  "author": "STLL",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/folio.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "clean": "git clean -xdf packages/*/dist .cache .turbo node_modules",
    "audit": "bun audit --audit-level=moderate --ignore=GHSA-5p4m-2wfm-xmqj",
    "check:parity-contract": "node scripts/check-parity-contract.mjs",
    "check:export-parity": "node scripts/check-export-parity.mjs",
    "check:react-compiler": "bun scripts/react-compiler-bailouts.ts --check",
    "check:lockfile-versions": "bun scripts/check-lockfile-workspace-versions.ts",
    "check:dedupe": "bun dedupe --check",
    "check:quarantine-excludes": "bun scripts/check-quarantine-excludes.ts",
    "check:build-reproducibility": "bun scripts/check-build-reproducibility.ts",
    "check:docx-kernel": "bun --filter '@stll/docx-core' wasm:check",
    "check:docx-kernel-version": "bun scripts/sync-docx-kernel-version.ts",
    "rust:hawk": "cargo +1.97.1 hawk check --target-dir target/hawk -D warnings -A hawk::dead_public -A hawk::unnecessary_public",
    "specifications:check": "bun scripts/specification-sources.ts check",
    "specifications:fetch": "bun scripts/specification-sources.ts fetch",
    "specifications:generate": "bun scripts/generate-ooxml-schema-graph.ts write",
    "specifications:generate:check": "bun scripts/generate-ooxml-schema-graph.ts check",
    "generate:joining-types": "bun scripts/generate-joining-types.ts write",
    "generate:joining-types:check": "bun scripts/generate-joining-types.ts check",
    "test:e2e:vue": "bunx playwright test --project=vue",
    "test:e2e:parity": "bunx playwright test --project=parity",
    "build": "bun --filter '@stll/docx-core' build && bun --filter '@stll/folio-core' build && bun --filter '@stll/folio-react' build && bun --filter '@stll/folio-agents' build && bun --filter '@stll/folio-vue' build && bun --filter '@stll/folio-nuxt' build",
    "build:docx-core": "bun --filter '@stll/docx-core' build",
    "build:core": "bun --filter '@stll/folio-core' build",
    "build:react": "bun --filter '@stll/folio-react' build",
    "typecheck": "bun --filter '*' typecheck && bun run typecheck:parity && bun run typecheck:tooling",
    "typecheck:parity": "tsc -p parity/tsconfig.check.json --noEmit",
    "typecheck:tooling": "bun scripts/tsc-native.ts -p scripts/tsconfig.budgets.json",
    "typecheck:budget": "bun scripts/typecheck-budget.ts --check",
    "typecheck:budget:write": "bun scripts/typecheck-budget.ts --write",
    "test": "bun --filter '*' test && bun test scripts",
    "test:property": "bun --filter '*' test:property",
    "typegen": "bun scripts/i18n-typegen.ts packages/core/src/i18n/messages",
    "i18n:sync": "bun scripts/i18n-check.ts packages/core/src/i18n/messages --sync && bun scripts/i18n-typegen.ts packages/core/src/i18n/messages && bun scripts/i18n-catalogs-gen.ts",
    "check:i18n": "bun scripts/i18n-typegen.ts packages/core/src/i18n/messages --check && bun scripts/i18n-catalogs-gen.ts --check && bun scripts/i18n-check.ts packages/core/src/i18n/messages && bun scripts/i18n-lint.ts packages/core/src/i18n/messages",
    "codemod:eigenpal": "bun scripts/migrate-eigenpal.ts",
    "lint": "bun --bun oxlint -c oxlint.config.ts packages scripts test benchmarks parity",
    "lint:fix": "bun --bun oxlint -c oxlint.config.ts --fix packages scripts test benchmarks parity",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "sync-ai": "bash .ai/shared/scripts/sync-ai-skills.sh .",
    "sync-ai:check": "bash .ai/shared/scripts/sync-ai-skills.sh --check .",
    "test:packaged-consumer": "bun scripts/packaged-consumer-build.ts",
    "test:packaged-consumer-smoke": "bun scripts/packaged-consumer-smoke.ts",
    "validate-dist": "bun scripts/validate-dist.ts docx-core && bun scripts/validate-dist.ts core && bun scripts/validate-dist.ts react && bun scripts/validate-dist.ts agents && bun scripts/validate-dist.ts vue && bun scripts/validate-dist.ts nuxt",
    "validate-dist:docx-core": "bun scripts/validate-dist.ts docx-core",
    "validate-dist:core": "bun scripts/validate-dist.ts core",
    "validate-dist:react": "bun scripts/validate-dist.ts react",
    "validate-dist:agents": "bun scripts/validate-dist.ts agents",
    "validate-dist:vue": "bun scripts/validate-dist.ts vue",
    "validate-dist:nuxt": "bun scripts/validate-dist.ts nuxt",
    "api:update": "bun scripts/api-reports.ts --update",
    "api:check": "bun scripts/api-reports.ts",
    "api:budget": "bun scripts/api-surface-budget.ts --check",
    "api:budget:write": "bun run api:update && bun scripts/api-surface-budget.ts --write",
    "changeset:version": "changeset version && bun scripts/sync-docx-kernel-version.ts --write && bun scripts/check-lockfile-workspace-versions.ts --write && bun install --frozen-lockfile && bun --filter '@stll/docx-core' wasm:generate",
    "bench": "bun benchmarks/index.ts",
    "bench:cross-language": "bun benchmarks/cross-language/run.ts",
    "parity": "bun parity/cli.ts",
    "parity:line-endpoints": "bun parity/lineEndpointsCli.ts",
    "parity:build-line-endpoint-fixtures": "bun parity/fixtures/build-word-line-endpoint-fixtures.ts",
    "test:visual": "bunx playwright test",
    "test:interactions": "bunx playwright test --project=interactions",
    "test:measure-parity": "bunx playwright test --project=measure-parity",
    "test:differential": "cd packages/core && bun test src/docx/__tests__/differential.test.ts",
    "test:visual:update": "bunx playwright test --update-snapshots",
    "test:visual:report": "bunx playwright show-report"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@codspeed/tinybench-plugin": "^5.7.1",
    "@formatjs/icu-messageformat-parser": "^3.5.12",
    "@microsoft/api-extractor": "7.58.11",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "^0.2.2",
    "@stll/folio-core": "workspace:*",
    "@stll/oxlint-config": "0.4.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.2.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "better-result": "3.0.1",
    "binaryen": "131.0.0",
    "bun-types": "1.4.0",
    "fast-check": "^4.9.0",
    "fast-xml-parser": "^5.10.1",
    "jszip": "3.10.1",
    "lightningcss": "1.32.0",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "0.25.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tinybench": "^6.0.2",
    "tsdown": "0.22.9",
    "typescript": "6.0.3",
    "use-intl": "^4.13.2"
  },
  "overrides": {
    "archiver": "8.0.0",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "prosemirror-model": "1.25.11",
    "prosemirror-view": "1.42.1",
    "undici": "8.9.0",
    "valibot": "1.4.2"
  },
  "packageManager": "bun@1.4.0"
}
