{
  "name": "stella-folio",
  "displayName": "Folio DOCX",
  "version": "0.5.7",
  "private": true,
  "description": "Open .docx files in VS Code and edit them on laid-out pages: type, track changes, comment, and save back to the same file. Also gives agent mode folio's .docx tools over MCP.",
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "docx",
    "editor",
    "mcp",
    "ooxml",
    "redline",
    "tracked changes"
  ],
  "homepage": "https://github.com/stella/folio/tree/main/plugins/vscode",
  "bugs": {
    "url": "https://github.com/stella/folio/issues"
  },
  "license": "Apache-2.0",
  "author": "STLL",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/folio.git",
    "directory": "plugins/vscode"
  },
  "publisher": "stll",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "bun scripts/build.ts",
    "vscode:prepublish": "bun scripts/build.ts",
    "package": "vsce package --no-dependencies --out folio.vsix",
    "publish": "vsce publish --no-dependencies --azure-credential",
    "publish:open-vsx": "ovsx publish folio.vsix",
    "test": "bun test src",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "test:smoke": "bun test/smoke/run.ts"
  },
  "devDependencies": {
    "@stll/fuzzy-search-wasm": "1.4.0",
    "@types/node": "26.6.5",
    "@types/vscode": "1.86.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "bun-types": "1.4.4",
    "esbuild": "0.28.2",
    "ovsx": "1.3.0",
    "vscode-previous-types": "npm:@types/vscode@1.85.0"
  },
  "overrides": {
    "@napi-rs/wasm-runtime": "1.1.6",
    "fast-uri": "3.1.9",
    "follow-redirects": "1.16.1",
    "markdown-it": "14.3.3",
    "undici": "7.30.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "folio.openReadOnly",
        "title": "Open Read-Only",
        "category": "Folio",
        "icon": "$(lock)"
      }
    ],
    "configuration": {
      "title": "Folio",
      "properties": {
        "folio.author": {
          "type": "string",
          "default": "",
          "markdownDescription": "Name recorded on every tracked change, comment, and reply, by the `.docx` editor and by the MCP server. When empty, defaults to `git config user.name`, then your OS account name."
        },
        "folio.editor.trackChanges": {
          "type": "string",
          "enum": [
            "off",
            "on"
          ],
          "default": "off",
          "enumDescriptions": [
            "Edits change the document directly.",
            "Edits are recorded as tracked changes."
          ],
          "markdownDescription": "How the `.docx` editor starts: `off` edits the document directly, `on` records every edit as a tracked change. The editor's toolbar switches between them at any time."
        },
        "folio.editor.confirmRewrite": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ask once per session before a save rewrites the whole document package instead of only the paragraphs you changed. The previous version is backed up in `.folio/backups/` either way."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "folio.docxEditor",
        "displayName": "Folio DOCX Editor",
        "selector": [
          {
            "filenamePattern": "*.docx"
          }
        ],
        "priority": "default"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "folio.mcp",
        "label": "Folio"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "folio.openReadOnly",
          "when": "resourceExtname == .docx"
        }
      ],
      "explorer/context": [
        {
          "command": "folio.openReadOnly",
          "when": "resourceExtname == .docx",
          "group": "navigation"
        }
      ]
    }
  },
  "activationEvents": [
    "onCustomEditor:folio.docxEditor",
    "onMcpCollection:folio.mcp"
  ],
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.86.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The editor works in untrusted workspaces. The MCP server, which can change files, is offered only once the workspace is trusted."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "The editor opens files on a virtual file system read-only (Save As still works). The MCP server needs workspace folders on disk."
    }
  },
  "trustedDependencies": []
}
