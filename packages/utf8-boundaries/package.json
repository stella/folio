    "format": "oxfmt ."
  },
  "dependencies": {
    "better-result": "3.0.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.87.0",
    "bun-types": "1.4.3",
    "tsdown": "0.22.9"
  },
  "peerDependencies": {
    "fast-check": "^4.9.0",
    "jszip": "^3.10.2"
  },
  "peerDependenciesMeta": {
    "fast-check": {
      "optional": true
    }
  }
}
