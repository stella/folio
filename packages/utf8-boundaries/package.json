{
  "name": "@stll/utf8-boundaries",
  "version": "0.0.0",
  "description": "Shared Unicode text, streaming codec, and ZIP entry boundaries.",
  "homepage": "https://github.com/stella/folio/tree/main/packages/utf8-boundaries",
  "bugs": {
    "url": "https://github.com/stella/folio/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/folio.git",
    "directory": "packages/utf8-boundaries"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/runtime.ts",
