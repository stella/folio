{
  "name": "@stll/folio-editor-web",
  "version": "0.0.0",
  "private": true,
  "description": "Internal bundle that mounts @stll/folio-react's editor behind a small host interface, for VS Code webviews and other embedding pages. Not published.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test src",
    "test:e2e": "bun scripts/build.ts && bunx playwright test -c playwright.config.ts",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.build.json"
  },
  "dependencies": {
    "@stll/folio-core": "workspace:*",
    "@stll/folio-react": "workspace:*",
    "@stll/utf8-boundaries": "workspace:*",
    "prosemirror-history": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "use-intl": "^4.14.9"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@stll/docx-core": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "prosemirror-model": "^1.25.9",
    "prosemirror-view": "^1.42.8"
  }
}
