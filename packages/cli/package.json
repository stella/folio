{
  "name": "@stll/folio-cli",
  "version": "0.5.7",
  "description": "Command line and stdio MCP server for reading, reviewing, and redlining .docx files with folio: tracked-change edits, comments, and comparisons written atomically with version preconditions.",
  "keywords": [
    "cli",
    "docx",
    "mcp",
    "ooxml",
    "redline",
    "tracked-changes",
    "word"
  ],
  "homepage": "https://github.com/stella/folio",
  "bugs": {
    "url": "https://github.com/stella/folio/issues"
  },
  "license": "Apache-2.0",
  "author": "STLL",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/folio.git",
    "directory": "packages/cli"
  },
  "bin": {
    "folio": "./src/bin.ts"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "./src/bin.ts"
  ],
  "exports": {
    ".": "./src/cli.ts",
    "./editor-lease": "./src/editor-lease.ts",
    "./save": "./src/save.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsdown",
    "prepack": "bun run build",
    "pack:dry-run": "bun pm pack --dry-run",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.build.json",
    "test": "bun test src"
  },
  "dependencies": {
    "@fontsource/arimo": "^5.2.8",
    "@fontsource/caladea": "^5.2.8",
    "@fontsource/carlito": "^5.2.8",
    "@fontsource/cousine": "^5.2.7",
    "@fontsource/lato": "^5.2.7",
    "@fontsource/noto-sans-arabic": "^5.2.7",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/tinos": "^5.2.7",
    "@modelcontextprotocol/server": "2.4.0",
    "@stll/agent-input": "0.2.0",
    "@stll/docx-core": "workspace:^",
    "@stll/folio-agents": "workspace:^",
    "@stll/folio-core": "workspace:^",
    "@stll/fuzzy-search": "1.4.0",
    "@stll/utf8-boundaries": "workspace:*",
    "better-result": "3.0.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "playwright-core": "1.64.1"
  },
  "peerDependencies": {
    "playwright-core": ">=1.50.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.9",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.6",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.31"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
