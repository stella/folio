{
  "name": "@stll/folio-agents",
  "version": "0.16.8",
  "description": "Framework-neutral LLM tool layer over folio's ai-edits engine: function-calling tools so an agent can read and mutate .docx documents through @stll/folio-core.",
  "keywords": [
    "agent",
    "ai",
    "docx",
    "function-calling",
    "llm",
    "ooxml",
    "tanstack-intent",
    "tools",
    "word"
  ],
  "homepage": "https://github.com/stella/folio",
  "bugs": {
    "url": "https://github.com/stella/folio/issues"
  },
  "license": "Apache-2.0",
  "author": "STLL",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/folio.git",
    "directory": "packages/agents"
  },
  "files": [
    "src",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsdown",
    "prepack": "bun run build",
    "pack:dry-run": "bun pm pack --dry-run",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.build.json",
    "test": "bun test src"
  },
  "dependencies": {
    "@stll/folio-core": "workspace:^",
    "@stll/utf8-boundaries": "workspace:*",
    "better-result": "3.0.1"
  },
  "devDependencies": {
    "@stll/docx-core": "workspace:*"
  },
  "peerDependencies": {
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.9",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.6",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.31"
  }
}
