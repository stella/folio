{
  "name": "@stll/folio-vue",
  "version": "0.26.0",
  "description": "Vue 3 editor for folio: a Word-document (.docx) editor for the browser, built on @stll/folio-core and ProseMirror.",
  "keywords": [
    "document-editor",
    "docx",
    "editor",
    "ooxml",
    "prosemirror",
    "vue",
    "word",
    "wysiwyg"
  ],
  "homepage": "https://github.com/stella/folio",
  "bugs": {
    "url": "https://github.com/stella/folio/issues"
  },
  "license": "Apache-2.0",
  "author": "STLL",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/folio.git",
    "directory": "packages/vue"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/composables.js",
      "require": "./dist/composables.cjs"
    },
    "./dialogs": {
      "types": "./dist/components/dialogs/index.d.ts",
      "import": "./dist/dialogs.js",
      "require": "./dist/dialogs.cjs"
    },
    "./styles": {
      "types": "./dist/styles/index.d.ts",
      "import": "./dist/styles.js",
      "require": "./dist/styles.cjs"
    },
    "./messages/*": {
      "types": "./dist/i18n/messages/*.d.ts",
      "import": "./dist/messages/*.js",
      "require": "./dist/messages/*.cjs"
    },
    "./messages": {
      "types": "./dist/i18n/messages.d.ts",
      "import": "./dist/messages.js",
      "require": "./dist/messages.cjs"
    },
    "./editor.css": "./dist/folio-vue.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && vite build && bun scripts/build-css.ts",
    "prepack": "bun run build",
    "pack:dry-run": "bun pm pack --dry-run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.build.json",
    "test": "bun test --preload ./test/vueDom.preload.ts src"
  },
  "dependencies": {
    "@fontsource/arimo": "^5.2.8",
    "@fontsource/caladea": "^5.2.8",
    "@fontsource/carlito": "^5.2.8",
    "@fontsource/cousine": "^5.2.7",
    "@fontsource/lato": "^5.2.7",
    "@fontsource/noto-sans-arabic": "^5.2.7",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/tinos": "^5.2.7",
    "@stll/folio-core": "workspace:^",
    "@stll/utf8-boundaries": "workspace:*",
    "better-result": "3.0.1",
    "use-intl": "^4.14.9"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/language-core": "^3.3.8",
    "prosemirror-history": "^1.5.1",
    "prosemirror-model": "^1.25.9",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.42.6",
    "vite": "8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13",
    "yjs": "^13.6.33"
  },
  "peerDependencies": {
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.9",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.6",
    "react": "^19.2.0",
    "vue": "^3.3.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.33"
  }
}
