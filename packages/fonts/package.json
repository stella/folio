{
  "name": "@stll/folio-fonts",
  "version": "0.0.0",
  "description": "The document fonts folio measures and paints with: metric-compatible open-licence faces, their @font-face stylesheet, and a Node reader for headless layout.",
  "keywords": [
    "docx",
    "fonts",
    "carlito",
    "caladea",
    "arimo",
    "tinos",
    "cousine",
    "metric-compatible"
  ],
  "homepage": "https://github.com/stella/folio/tree/main/packages/fonts",
  "bugs": {
    "url": "https://github.com/stella/folio/issues"
  },
  "license": "OFL-1.1 AND Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/folio.git",
    "directory": "packages/fonts"
  },
  "files": [
    "dist",
    "src",
    "fonts",
    "fonts.css",
    "licenses",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./fonts.css": "./fonts.css",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsdown",
    "test": "bun test src",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.build.json",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@fontsource/arimo": "5.3.0",
    "@fontsource/caladea": "5.3.0",
    "@fontsource/carlito": "5.3.0",
    "@fontsource/cousine": "5.3.0",
    "@fontsource/lato": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "@fontsource/tinos": "5.3.0",
    "@types/node": "^26.6.5",
    "bun-types": "1.4.4",
    "tsdown": "0.23.1"
  }
}
