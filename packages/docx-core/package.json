{
  "name": "@stll/docx-core",
  "version": "0.39.0",
  "description": "Typed OOXML/DOCX model, validation, serialization, legal-source compilation, and browser-native package projection.",
  "keywords": [
    "document-model",
    "docx",
    "legal",
    "ooxml",
    "openxml",
    "serialize",
    "validate",
    "word"
  ],
  "homepage": "https://github.com/stella/folio/tree/main/packages/docx-core",
  "bugs": {
    "url": "https://github.com/stella/folio/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/folio.git",
    "directory": "packages/docx-core"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "NOTICE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model/document.ts",
    "./ops": "./src/ops/documentOps.ts",
    "./projection": "./src/projection.ts",
    "./schema": "./src/schema/sequenceChildren.ts",
    "./zip": "./src/zip/writeZipPart.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "git clean -xdf dist .cache .turbo node_modules",
    "build": "rm -rf dist && tsdown",
    "pack:dry-run": "bun pm pack --dry-run",
    "test": "bun test src",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.build.json",
    "wasm:check": "bun ../../scripts/build-docx-kernel-wasm.ts --check",
    "wasm:generate": "bun ../../scripts/build-docx-kernel-wasm.ts --write",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@nodable/entities": "^3.0.0",
    "@stll/docx-utils": "^0.2.0",
    "@stll/utf8-boundaries": "workspace:*",
    "better-result": "3.0.1",
    "fast-xml-parser": "^5.11.2",
    "jszip": "3.10.2",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "bun-types": "1.4.4",
    "tsdown": "0.23.1"
  }
}
