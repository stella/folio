{
  "name": "@stll/folio-core",
  "version": "0.64.0",
  "description": "Headless, framework-neutral core of folio: the OOXML (.docx) parser, document model, ProseMirror integration, and page-layout engine. No React.",
  "keywords": [
    "document-model",
    "docx",
    "headless",
    "ooxml",
    "pagination",
    "prosemirror",
    "redline",
    "tracked-changes",
    "word"
  ],
  "homepage": "https://github.com/stella/folio",
  "bugs": {
    "url": "https://github.com/stella/folio/issues"
  },
  "license": "Apache-2.0",
  "author": "STLL",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/folio.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/__tests__/**",
    "!dist/**/__fixtures__/**",
    "!dist/**/fixtures/**",
    "!dist/**/__snapshots__/**",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__/**",
    "!src/**/__fixtures__/**",
    "!src/**/fixtures/**",
    "!src/**/__snapshots__/**",
    "README.md",
    "NOTICE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./i18n/messages/*": "./src/i18n/messages/*.gen.ts",
    "./i18n/messages/*.gen": "./src/i18n/messages/*.gen.ts",
    "./i18n/messages/locales": "./src/i18n/messages/locales.ts",
    "./markdown": "./src/markdown/index.ts",
    "./server": "./src/server.ts",
    "./redline": "./src/redline.ts",
    "./ai-edits": "./src/ai-edits/index.ts",
    "./content-controls": "./src/content-controls/index.ts",
    "./compat/eigenpal": "./src/compat/eigenpal.ts",
    "./watermark": "./src/watermark/index.ts",
    "./layout-engine": "./src/layout-engine/index.ts",
    "./layout-painter": "./src/layout-painter/index.ts",
    "./layout-bridge/engine/measuring": "./src/layout-bridge/engine/measuring/index.ts",
    "./prosemirror": "./src/prosemirror/index.ts",
    "./prosemirror/attrs": "./src/prosemirror/attrs/index.ts",
    "./prosemirror/conversion": "./src/prosemirror/conversion/index.ts",
    "./prosemirror/extensions": "./src/prosemirror/extensions/index.ts",
    "./prosemirror/schema": "./src/prosemirror/schema/index.ts",
    "./docx": "./src/docx/index.ts",
    "./docx/document-clone": "./src/docx/documentClone.ts",
    "./text-shaping": "./src/text-shaping.ts",
    "./text-shaping/wasm": "./src/generated/text_shaper_bg.wasm",
    "./docx/paragraphPropertySource": null,
    "./internal/*": null,
    "./_virtual/*": null,
    "./generated/*": null,
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsdown",
    "prepack": "bun run build",
    "pack:dry-run": "bun pm pack --dry-run",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.build.json",
    "test": "bun test src scripts",
    "test:conformance:full": "FOLIO_CONFORMANCE=full bun test src/__tests__/editorCommandConformance.test.ts",
    "wasm:check": "bun ../../scripts/build-shaper-wasm.ts --check",
    "wasm:generate": "bun ../../scripts/build-shaper-wasm.ts --write",
    "test:property": "bun test $(grep -rlE 'fc\\.(assert|check)\\(|assertProperty\\(' src --include='*.test.ts')",
    "perf": "bun scripts/profile-editor.ts"
  },
  "dependencies": {
    "@stll/docx-core": "workspace:^",
    "@stll/docx-utils": "^0.2.0",
    "@stll/template-conditions": "^0.6.2",
    "@stll/utf8-boundaries": "workspace:*",
    "better-result": "3.0.1",
    "csstype": "^3.1.3",
    "dompurify": "^3.4.17",
    "fast-xml-parser": "^5.11.2",
    "hyphen": "1.14.1",
    "jszip": "3.10.2",
    "utif2": "^4.1.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-hebrew": "^5.3.0",
    "@types/hyphen": "1.14.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.9",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.4",
    "prosemirror-view": "^1.42.7",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.33"
  },
  "peerDependencies": {
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.9",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.33"
  }
}
